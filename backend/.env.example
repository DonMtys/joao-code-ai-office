# Model routing. Keep real credentials only in backend/.env.
AI_CHEAP_MODEL=
AI_MEDIUM_MODEL=
AI_PREMIUM_MODEL=

# Local model example (Ollama OpenAI-compatible endpoint).
AI_LOCAL_ENABLED=true
AI_LOCAL_MODEL=openai/qwen2.5-coder:1.5b
AI_LOCAL_API_BASE=http://127.0.0.1:11434/v1
AI_LOCAL_API_KEY=ollama
AI_ALLOW_PAID_FALLBACK=false

# Cost and local persistence.
AI_MONTHLY_BUDGET_BRL=100
AI_USD_TO_BRL=5
AI_CACHE_ENABLED=false
AI_SAVINGS_ENABLED=true
AI_USAGE_LOG_PATH=storage/ai_usage.jsonl
AI_SAVINGS_DB_PATH=storage/context_savings.sqlite3
CODE_MEMORY_DB_PATH=storage/code_memory.sqlite3

# Optional paid providers. Never commit the real values.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

